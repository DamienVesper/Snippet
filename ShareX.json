{
  "$schema": "./SXCUSchema.json",
  "Version": "21.0.0",
  "Name": "Snippet",
  "DestinationType": "ImageUploader, TextUploader, FileUploader",
  "RequestMethod": "POST",
  "RequestURL": "{{ORIGIN}}/api/upload",
  "Body": "MultipartFormData",
  "Headers": {
    "Authorization": "Bearer {{API_KEY}}",
    "Origin": "{{ORIGIN}}"
  },
  "FileFormName": "file",
  "URL": "{json:url}"
}
